# Quest Deadline Control - Variáveis de Ambiente (Opcionais)
# Na Vercel, o site funciona de forma imediata (zero-config).
# As variáveis abaixo podem ser configuradas no painel da Vercel caso deseje customizar:

# URL Base da Aplicação (ex: https://quest-deadlines.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta opcional para proteger os endpoints de Cron na Vercel (/api/cron/*)
CRON_SECRET=
