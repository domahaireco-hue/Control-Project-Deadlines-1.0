# ==============================================================================
# Quest Deadline Control - Variáveis de Ambiente
# ==============================================================================

# URL Base da Aplicação (ex: https://quest-deadlines.vercel.app ou http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & REALTIME (Sincronização em Nuvem para toda a equipe)
# Obtenha em: https://supabase.com -> Seu Projeto -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# (Opcional para APIs no servidor / Cron Jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Chave secreta OBRIGATÓRIA em produção para proteger os endpoints de Cron (/api/cron/*, /api/send-daily-report)
# ------------------------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------------------------
# AGENTMAIL API (Alertas de Tratativa 72h e Alertas Críticos)
# ------------------------------------------------------------------------------
# Obrigatório: sem estas variáveis nenhum e-mail é enviado (a chave NÃO fica mais no código).
AGENTMAIL_API_KEY=your-agentmail-api-key
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to

# ------------------------------------------------------------------------------
# SESSÃO DE LOGIN (OBRIGATÓRIO em produção, mínimo 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
SESSION_SECRET=

