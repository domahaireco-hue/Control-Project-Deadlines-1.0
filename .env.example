# ==============================================================================
# Quest Deadline Control - Variáveis de Ambiente
# ==============================================================================

# URL Base da Aplicação (ex: https://quest-deadlines.vercel.app ou http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & REALTIME (Sincronização em Nuvem para toda a equipe)
# Obtenha em: https://supabase.com -> Seu Projeto -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# (Opcional para APIs no servidor / Cron Jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Chave secreta opcional para proteger os endpoints de Cron na Vercel (/api/cron/*)
# ------------------------------------------------------------------------------
CRON_SECRET=
